#!/bin/zsh
# Changing focus
cmd - j: yabai -m window --focus next
cmd - k: yabai -m window --focus prev
cmd - h: yabai -m window --focus west
cmd - l: yabai -m window --focus east
cmd + lshift - i: yabai -m display --focus prev
cmd + lshift - o: yabai -m display --focus next
lctrl + lshift - i:  yabai -m space --display prev
lctrl + lshift - o:  yabai -m space --display next

# Moving windows
lctrl + lshift - h: yabai -m window --warp west
lctrl + lshift - j: yabai -m window --warp south
lctrl + lshift - k: yabai -m window --warp north
lctrl + lshift - l: yabai -m window --warp east

# Resize windows
cmd + lshift - h: yabai -m window --resize left:-50:0; \
    yabai -m window --resize right:-50:0
cmd + lshift - j: yabai -m window --resize bottom:0:50; \
    yabai -m window --resize top:0:50
cmd + lshift - k: yabai -m window --resize top:0:-50; \
    yabai -m window --resize bottom:0:-50
cmd + lshift - l: yabai -m window --resize right:50:0; \
    yabai -m window --resize left:50:0

cmd + lshift - s: yabai -m window --toggle sticky

# Equalize size of windows
cmd + lshift - e: yabai -m space --balance

# Rotate windows
cmd - space: yabai -m space --rotate 90

# Rotate on X and Y Axis
cmd - x: yabai -m space --mirror x-axis
cmd - y: yabai -m space --mirror y-axis

# Float / Unfloat window
cmd + lshift - f: \
    yabai -m window --toggle float; \
    yabai -m window --toggle border

cmd - f : yabai -m window --focus first

# Make window native fullscreen
cmd - m: yabai -m window --toggle zoom-fullscreen

# Quit and restart yabai
# hyper - q: brew services stop yabai
# hyper - s: brew services start yabai
# lshift + alt - r: yabai --service-stop; yabai --service-start
#Open terminal in the current window
cmd - return : /Applications/alacritty.app/Contents/MacOS/alacritty
cmd + lshift - w: "open /Applications/Visual Studio Code.app"
# Move current window to space 1
ctrl + lshift - 1: yabai -m window --space 1
ctrl + lshift - 2: yabai -m window --space 2
ctrl + lshift - 3: yabai -m window --space 3
ctrl + lshift - 4: yabai -m window --space 4
ctrl + lshift - 5: yabai -m window --space 5
ctrl + lshift - 6: yabai -m window --space 6
ctrl + lshift - 7: yabai -m window --space 7
ctrl + lshift - 8: yabai -m window --space 8
ctrl + lshift - 9: yabai -m window --space 9
# cmd - tab: yabai -m space --focus recent
cmd - e : $HOME/.config/skhd/open_emacsclient.sh
# hyper - 4: yabai -m window --space 4
# hyper - 5: yabai -m window --space 5
# hyper - 6: yabai -m window --space 6
# cmd - 1: yabai -m space --focus 1
# cmd - 2: yabai -m space --focus 2
# cmd - 3: yabai -m space --focus 3
# cmd - 4: yabai -m space --focus 4
# cmd - 5: yabai -m space --focus 5
# cmd - 6: yabai -m space --focus 6
# cmd - 7: yabai -m space --focus 7
# cmd - 8: yabai -m space --focus 8
# cmd - 9: yabai -m space --focus 9
# cmd - q : $HOME/.config/skhd/kill_last_instance.sh

cmd - q : yabai -m window --close
cmd + lshift - m : yabai -m window --minimize
cmd - d: dmenu-mac
lctrl + lshift - p : ~/.config/bin/mpv-url
