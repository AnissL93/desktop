# skhd — companion to AeroSpace (~/.config/aerospace/aerospace.toml)
#
# ONLY the cmd-arrow bindings live here. Real arrow-key events on macOS carry
# an implicit 'fn' modifier flag, which AeroSpace's hotkey matching does not
# accept — so AeroSpace never sees cmd-arrows from the keyboard (a synthetic
# fn-less cmd-left DOES trigger it). skhd's CGEventTap handles arrows fine.
# Every other binding is defined in AeroSpace itself.
#
# Old yabai-era config: skhdrc.yabai.bak

cmd - left  : /opt/homebrew/bin/aerospace workspace --wrap-around prev
cmd - right : /opt/homebrew/bin/aerospace workspace --wrap-around next
cmd - up    : /opt/homebrew/bin/aerospace focus-monitor prev
cmd - down  : /opt/homebrew/bin/aerospace focus-monitor next
