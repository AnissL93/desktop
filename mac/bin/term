#!/bin/sh
# term [CMD...]: a new kitty window, in the running kitty when there is one (instant; starting kitty
# takes ~1 s). kitty listens on /tmp/kitty-$USER-<pid> (dotfiles/kitty/kitty.conf).
export PATH=/opt/homebrew/bin:$PATH
for s in /tmp/kitty-"$USER"-*; do
    # kitty is in the background: `open -a` brings it, and so the new window, to the front
    [ -S "$s" ] && kitten @ --to "unix:$s" launch --type=os-window --cwd="$HOME" "$@" >/dev/null 2>&1 &&
        exec open -a kitty
done
exec open -na kitty --args "$@"
